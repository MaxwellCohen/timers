<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: the next timer with pause and +1 minute, or the last-used duration when there is none. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/te_bg_widget"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:padding="16dp">

  <LinearLayout
    android:id="@+id/te_open"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/te_label"
        style="@style/Te.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/te_sample_label"
        android:textColor="@color/te_text"
        android:textSize="13sp" />

      <TextView
        android:id="@+id/te_more"
        style="@style/Te.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/te_gap"
        android:text="@string/te_sample_more" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="4dp"
      android:layout_marginBottom="4dp"
      android:layout_weight="1">

      <Chronometer
        android:id="@+id/te_chrono"
        style="@style/Te.Digits"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoSizeMaxTextSize="46sp"
        android:gravity="center_vertical|start"
        android:textSize="46sp"
        android:visibility="gone" />

      <TextView
        android:id="@+id/te_digits"
        style="@style/Te.Digits"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoSizeMaxTextSize="46sp"
        android:gravity="center_vertical|start"
        android:text="@string/te_sample_digits"
        android:textSize="46sp" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/te_button"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/te_bg_pill_accent"
      android:scaleType="center"
      android:src="@drawable/te_ic_pause" />

    <TextView
      android:id="@+id/te_plus"
      style="@style/Te.Label"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="@dimen/te_gap"
      android:layout_weight="1"
      android:background="@drawable/te_bg_pill_raised"
      android:fontFamily="sans-serif-medium"
      android:gravity="center"
      android:text="@string/te_plus_minute"
      android:textColor="@color/te_text"
      android:textFontWeight="600"
      android:textSize="13sp" />
  </LinearLayout>
</LinearLayout>
